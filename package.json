{
  "name": "interface-ai-takehome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Computer-use automation system: LLM discovery -> typed capability artifact -> deterministic replay -> human handoff",
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:artifacts": "tsx scripts/validate-artifacts.ts",
    "emit:jsonschema": "tsx scripts/emit-json-schema.ts",
    "target-app": "tsx target-app/server.ts",
    "smoke:adapter": "tsx scripts/smoke-adapter.ts",
    "replay": "tsx scripts/replay.ts",
    "operator": "tsx scripts/operator-console.ts",
    "discover": "tsx scripts/discover.ts",
    "compile": "tsx scripts/compile.ts",
    "promote": "tsx scripts/promote.ts",
    "replay:tenant": "tsx scripts/replay-tenant.ts",
    "catalog:demo": "tsx scripts/catalog-demo.ts",
    "inspect": "tsx scripts/inspect-page.ts",
    "mcp": "tsx scripts/mcp-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "playwright": "^1.63.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "3.23.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^3.2.0"
  }
}
